# GitHub OAuth app client id, used for the device-flow sign-in.
#
# There is no client secret: Chief uses GitHub's device flow precisely so that
# no secret has to ship inside the binary. The client id is not sensitive.
#
# To get one: GitHub → Settings → Developer settings → OAuth Apps → New OAuth App,
# then enable "Device flow" on the app's settings page.
CHIEF_GITHUB_CLIENT_ID=
