{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chief",
  "version": "0.24.0",
  "identifier": "com.scottmallinson.chief",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chief",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A privacy-first, on-device AI chief of staff.",
    "longDescription": "Chief is an AI chief of staff that runs entirely on your machine. It ships with llama.cpp and runs the model itself, stores everything in a local SQLite database, and never sends your work to a remote server.",
    "copyright": "Copyright © 2026 Scott Mallinson",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/llama-server"],
    "resources": {
      "binaries/lib/*": "./"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "fragmentPaths": ["windows/login-entry.wxs"],
        "componentGroupRefs": ["ChiefLoginEntry"],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "publisher": "Scott Mallinson",
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:chief.db"]
    }
  }
}
