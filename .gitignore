# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr
coverage
*.local

# Playwright output
test-results
playwright-report
blob-report
playwright/.cache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local secrets — never commit OAuth client ids/secrets or tokens
.env
.env.*
!.env.example

# Local user data (SQLite lives in the OS app-data dir, but keep strays out)
*.sqlite
*.sqlite3
*.db

# The bundled llama.cpp engine. Fetched per-platform by `pnpm engine:fetch`,
# not committed — it is tens of megabytes of prebuilt binary.
src-tauri/binaries

# Model weights, wherever one is left lying around. The app keeps its own in
# the OS app-data directory.
*.gguf
